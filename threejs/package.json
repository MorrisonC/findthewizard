{
  "name": "veilkeep-threejs",
  "version": "1.0.0",
  "private": true,
  "description": "VEILKEEP - 2.5D Isometric Victorian Gothic Steampunk Action-RPG in Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:world": "node --experimental-strip-types --no-warnings scripts/validate-world.mjs",
    "e2e": "node e2e/autobattler.spec.mjs",
    "e2e:qa": "node e2e/qa-hooks.spec.mjs",
    "e2e:boot": "node e2e/boot.spec.mjs",
    "e2e:autoplay": "node e2e/autoplay.spec.mjs",
    "e2e:autoplay:mobile": "node e2e/autoplay-mobile.spec.mjs",
    "e2e:autoplay:pacifist": "node e2e/autoplay-pacifist.spec.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
